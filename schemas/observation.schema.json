{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subc.observation.v1",
  "title": "SUBCONSCIOUS Observation",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "source",
    "evidence_uri",
    "observed_at",
    "confidence",
    "redacted",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "source": {
      "enum": [
        "hermes",
        "hermes-sessions",
        "correction-mining",
        "openclaw",
        "openclaw-sessions",
        "openclaw-semantic",
        "goclaw",
        "mem0g",
        "project-flow",
        "promise-reality",
        "manual"
      ]
    },
    "source_adapter": {
      "type": "string"
    },
    "evidence_uri": {
      "type": "string"
    },
    "observed_at": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "redacted": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
