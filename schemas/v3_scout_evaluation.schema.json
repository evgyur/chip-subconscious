{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/subconscious/v3_scout_evaluation.schema.json",
  "title": "SUBCONSCIOUS v3 semantic evaluator response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "proposals"],
  "properties": {
    "schema_version": {"const": "subc-v3-scout-evaluation/1"},
    "status": {"enum": ["ok", "empty", "blocked", "timeout", "error"]},
    "proposals": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_event_ids", "single_source_exception", "exception_reason", "proposal"],
        "properties": {
          "evidence_event_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^evt_[a-f0-9]{16,64}$"}
          },
          "single_source_exception": {"type": "boolean"},
          "exception_reason": {"type": "string", "maxLength": 500},
          "proposal": {"type": "object"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "empty"}}, "required": ["status"]},
      "then": {"properties": {"proposals": {"maxItems": 0}}}
    }
  ]
}
